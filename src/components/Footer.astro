---
import FooterLinks from './FooterLinks.jsx';
---

<FooterLinks />

<style>
	:global(.site-footer) {
		padding: 2em 1em 6em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	:global(.social-links) {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}

	:global(.social-links a) {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	:global(.social-links a:hover) {
		color: rgb(var(--gray-dark));
	}

	:global(.social-links svg) {
		width: 1.25rem;
		height: 1.25rem;
	}

	:global(.site-footer small) {
		display: block;
		margin-top: 1.5em;
	}
</style>
