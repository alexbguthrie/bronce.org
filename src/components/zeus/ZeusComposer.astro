---
/** Welcome prompt, shared message form, and prompt shortcuts for the Zeus chat shell. */
---

<section class="zeus-home" data-home-view aria-labelledby="zeus-heading">
	<h1 id="zeus-heading">What can I help with?</h1>
	<!-- ZeusChat.astro moves this single form from the welcome view into the chat dock after submit. -->
	<form class="zeus-composer" data-composer aria-label="Message Zeus">
		<button type="button" class="zeus-add" aria-label="Add attachment" disabled>+</button>
		<textarea
			class="zeus-input"
			name="message"
			rows="1"
			placeholder="Ask Zeus"
			aria-label="Message Zeus"
			autocomplete="off"
			data-message-input
		></textarea>
		<div class="zeus-composer-tools">
			<button type="button" class="zeus-mode" disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a4 4 0 0 0-4 4v10a4 4 0 0 0 8 0V7a4 4 0 0 0-4-4Z" /><path d="M4 11v2a8 8 0 0 0 16 0v-2M12 21v-3" /></svg>
				Ask
			</button>
			<button type="button" class="zeus-mic" aria-label="Voice input" disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2" width="6" height="13" rx="3" /><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8" /></svg>
			</button>
			<button type="submit" class="zeus-send" aria-label="Send message" disabled data-send-message>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-7 7 7-7 7 7" /></svg>
			</button>
		</div>
	</form>
	<!-- ZeusChat.astro reads each data-suggestion value and uses it to prefill the message field. -->
	<nav class="zeus-suggestions" aria-label="Suggested prompts">
		<button type="button" data-suggestion="Create a simple image idea for the bronce website"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>Create an image</button>
		<button type="button" data-suggestion="Help me write a short introduction for my personal website"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5 4 4M4 20l4-.8L19.1 8.1a2.1 2.1 0 0 0-3-3L5 16.2Z" /></svg>Write or edit</button>
		<button type="button" data-suggestion="What can I explore on bronce.org?"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.4-4.4" /></svg>Explore bronce.org</button>
	</nav>
</section>
