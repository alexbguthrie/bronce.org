---
/** Conversation transcript and the dock that receives the shared composer after the first send. */
---

<section class="zeus-chat" data-chat-view aria-label="Conversation" hidden>
	<!-- ZeusChat adds user and assistant message elements here as the thread runs. -->
	<div class="zeus-messages" data-messages aria-live="polite"></div>
	<!-- The shared composer is moved here once the first prompt opens the transcript. -->
	<div class="zeus-chat-dock" data-chat-dock></div>
</section>
