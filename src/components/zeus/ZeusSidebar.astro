---
/** Assistant navigation rail; its home link leaves Zeus and its new-chat control resets the active thread. */
import { SITE_TITLE } from '../../consts';
---

<aside class="zeus-sidebar" aria-label="Zeus navigation">
	<a class="zeus-back" href="/" aria-label="Back to bronce home" title="Back to home">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12" /></svg>
	</a>

	<nav class="zeus-tools" aria-label="Assistant tools">
		<!-- New conversation is wired by ZeusChat; the other tools stay disabled until implemented. -->
		<button type="button" aria-label="New conversation" title="New conversation" data-new-chat>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" /></svg>
		</button>
		<button type="button" aria-label="Search conversations" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
		</button>
		<button type="button" aria-label="Pinned conversations" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 3 5 5-4 1-4 4-1 5-2-2-5 5 4-6-2-2 5-1 4-4Z" /></svg>
		</button>
		<button type="button" aria-label="Conversation history" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8Z" /></svg>
		</button>
		<button type="button" aria-label="Your library" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21Z" /><path d="M4 5.5v13A2.5 2.5 0 0 1 6.5 16H20M8 7h8M8 10h8" /></svg>
		</button>
	</nav>

	<a class="zeus-avatar" href="/" aria-label={`Return to ${SITE_TITLE}`}>b</a>
</aside>
