---
import BaseHead from '../components/BaseHead.astro';
import SiteMenu from '../components/SiteMenu.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// The optional overrides let content pages set their own browser title and description.
interface Props {
	title?: string;
	description?: string;
	pageLabel?: string;
	wide?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, pageLabel, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<SiteMenu pageLabel={pageLabel} />
		<main class:list={['page-shell', { 'page-shell-wide': wide }]} id="main-content">
			<slot />
		</main>
	</body>
</html>
