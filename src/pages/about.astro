---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PROFILE, SITE_TITLE } from '../consts';
---

<SiteLayout title={`About · ${SITE_TITLE}`} pageLabel="About" description={PROFILE.intro}>
	<article class="prose">
		<h1 class="page-title">About</h1>
		<p>Hi, I’m {PROFILE.name}. This site is where I collect my writing, projects, and notes.</p>
	</article>
</SiteLayout>
